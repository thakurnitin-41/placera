# Placera Frontend Configuration (Vercel)

# VITE_API_BASE_URL: Set this to your deployed Render FastAPI service URL
# Example: https://placera-api.onrender.com
# Configure this in Vercel under: Project Settings -> Environment Variables
VITE_API_BASE_URL="https://placera-api.onrender.com"

# Optional: Gemini API Key for AI features
GEMINI_API_KEY="MY_GEMINI_API_KEY"

