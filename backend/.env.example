# Backend Configuration (Render / Local)

# DATABASE_URL: Managed PostgreSQL connection string (auto-injected by Render Blueprint)
# Format: postgresql+psycopg://username:password@hostname:5432/dbname
DATABASE_URL=postgresql+psycopg://placera:change-me@localhost:5432/placera

# ALLOWED_ORIGINS: Comma-separated allowed frontend origins (e.g. your Vercel deployment URL)
# Wildcard * or https://*.vercel.app are supported
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000